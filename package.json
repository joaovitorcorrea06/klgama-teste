{
  "name": "ecocoleta",
  "version": "0.1.0",
  "private": true,
  "description": "Portal de Coletas e Indicadores — desafio KL GAMA",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.11.0",
    "npm": ">=10"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n api,web -c cyan,yellow \"npm run dev -w @ecocoleta/api\" \"npm run dev -w @ecocoleta/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test --workspaces",
    "test:db": "npm run test:db -w @ecocoleta/api",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:up": "docker compose up -d --wait db",
    "db:check": "npm run db:check -w @ecocoleta/api",
    "db:seed": "npm run db:seed -w @ecocoleta/api",
    "db:migrate": "npm run db:migrate -w @ecocoleta/api",
    "db:revert": "npm run db:revert -w @ecocoleta/api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "concurrently": "9.2.5",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
