# Uso local. Copie para .env. Estes valores são exclusivos de demonstração.
# NODE_ENV usa development localmente e production nos containers.
# Não defina NODE_ENV neste arquivo compartilhado com o Vite.
API_PORT=3000
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ecocoleta
DB_USER=ecocoleta
DB_PASSWORD=ecocoleta_local_only
DB_SSL=false

# O navegador usa /api; Vite e Nginx encaminham para a API.
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://127.0.0.1:3000

# Gere com: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# O exemplo abaixo é recusado pela API; substitua por um segredo gerado.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1h
COOKIE_SECURE=false
# Habilite somente atrás de um proxy confiável, como o Nginx do Compose.
API_TRUST_PROXY=false

# Documentação opcional, com autenticação Basic própria, separada do JWT da API.
# Para habilitar, defina true e execute npm run setup para gerar sua senha local.
SWAGGER_ENABLED=false
SWAGGER_USER=avaliacao
SWAGGER_PASSWORD=replace-with-a-separate-documentation-password
